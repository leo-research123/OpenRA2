include_guard(GLOBAL)

# A parent-provided dependency or explicit installation remains usable offline.
# Otherwise build the pinned dependency through the project third_party adapter.
if(TARGET ICU::i18n OR TARGET ICU::uc OR TARGET ICU::data)
    if(NOT (TARGET ICU::i18n AND TARGET ICU::uc AND TARGET ICU::data))
        message(FATAL_ERROR "A parent-provided ICU must define i18n, uc and data targets together.")
    endif()
    message(STATUS "ICU: using parent-provided targets")
elseif(ICU_ROOT OR NOT "$ENV{ICU_ROOT}" STREQUAL "")
    set(ra2_icu_saved_suffixes "${CMAKE_FIND_LIBRARY_SUFFIXES}")
    if(WIN32)
        # FindICU normally prefers DLL import libraries. Select upstream static
        # names explicitly; the caller supplies an ICU build with the matching CRT.
        foreach(component IN ITEMS I18N UC DATA)
            if(component STREQUAL "I18N")
                set(names sicuin sicui18n)
                set(debug_names sicuind sicui18nd)
            elseif(component STREQUAL "UC")
                set(names sicuuc)
                set(debug_names sicuucd)
            else()
                set(names sicudt sicudata)
                set(debug_names sicudtd sicudatad)
            endif()
            find_library(ICU_${component}_LIBRARY_RELEASE NAMES ${names}
                HINTS "${ICU_ROOT}" "$ENV{ICU_ROOT}" PATH_SUFFIXES lib lib64 REQUIRED)
            find_library(ICU_${component}_LIBRARY_DEBUG NAMES ${debug_names}
                HINTS "${ICU_ROOT}" "$ENV{ICU_ROOT}" PATH_SUFFIXES lib lib64)
        endforeach()
    else()
        set(CMAKE_FIND_LIBRARY_SUFFIXES ".a")
    endif()
    find_package(ICU 70 REQUIRED COMPONENTS i18n uc data)
    set(CMAKE_FIND_LIBRARY_SUFFIXES "${ra2_icu_saved_suffixes}")
    if(NOT WIN32)
        foreach(component IN ITEMS I18N UC DATA)
            if(NOT ICU_${component}_LIBRARY_RELEASE MATCHES "\\.a$")
                message(FATAL_ERROR "ICU must use static archives; clear cached ICU library paths and provide ICU_ROOT.")
            endif()
        endforeach()
    endif()
else()
    add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/third_party/icu"
        "${CMAKE_CURRENT_BINARY_DIR}/_deps/ra2-icu-build")
endif()
add_library(ra2_text_encoding STATIC bridge/src/text_encoding.cpp)
ra2_configure_cpp_target(ra2_text_encoding)
set_target_properties(ra2_text_encoding PROPERTIES POSITION_INDEPENDENT_CODE ON
    CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
target_compile_definitions(ra2_text_encoding PRIVATE U_STATIC_IMPLEMENTATION)
target_link_libraries(ra2_text_encoding PUBLIC ICU::i18n ICU::uc ICU::data)
if(NOT WIN32)
    find_package(Threads REQUIRED)
    target_link_libraries(ra2_text_encoding PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
endif()
if(UNIX AND NOT APPLE)
    target_link_libraries(ra2_text_encoding PUBLIC m)
endif()
