# Shader compilation is a host build step. The renderer ships SPIR-V, never GLSL imports.
set(RA2_GLSLANG_EXECUTABLE "" CACHE FILEPATH "Optional host shader compiler; empty builds pinned third_party glslang")
if(RA2_GLSLANG_EXECUTABLE)
    if(NOT IS_ABSOLUTE "${RA2_GLSLANG_EXECUTABLE}" OR
       NOT EXISTS "${RA2_GLSLANG_EXECUTABLE}" OR IS_DIRECTORY "${RA2_GLSLANG_EXECUTABLE}")
        message(FATAL_ERROR "RA2_GLSLANG_EXECUTABLE must name an existing host executable, or be empty for bundled glslang.")
    endif()
    set(ra2_shader_compiler "${RA2_GLSLANG_EXECUTABLE}")
    set(ra2_shader_compiler_dependencies "${RA2_GLSLANG_EXECUTABLE}")
    message(STATUS "Shader compiler: explicit host executable ${RA2_GLSLANG_EXECUTABLE}")
else()
    add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/third_party/glslang"
        "${CMAKE_CURRENT_BINARY_DIR}/_deps/ra2-glslang-build")
endif()
set(ra2_shader_stage "${CMAKE_CURRENT_BINARY_DIR}/render-shaders")
file(MAKE_DIRECTORY "${ra2_shader_stage}")
set(ra2_spirv_headers)
set(ra2_shader_header "#pragma once\n#include \"render/shader.hpp\"\n")
foreach(shader IN ITEMS map_draw map_present map_abuffer map_abuffer_batch map_light_field map_light_page map_raster map_voxel map_page map_resolve map_ring map_ring_tile map_sprite map_sprite_compute map_sprite_lighting map_resource_upload)
    set(source_name "${shader}")
    set(shader_define "")
    if(shader STREQUAL "map_sprite")
        set(source_name map_raster)
        set(shader_define "RESIDENT_RESOURCES")
    elseif(shader STREQUAL "map_sprite_compute")
        set(source_name map_draw)
        set(shader_define "RESIDENT_RESOURCES")
    elseif(shader STREQUAL "map_sprite_lighting")
        set(source_name map_abuffer_batch)
        set(shader_define "RESIDENT_RESOURCES")
    elseif(shader STREQUAL "map_ring_tile")
        set(source_name map_resolve)
        set(shader_define "RING_TILE")
    endif()
    set(stages)
    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/render/shaders/${source_name}.comp")
        set(stages comp)
    else()
        set(stages vert frag)
    endif()
    set(program "inline constexpr ShaderProgram ${shader}_program{")
    foreach(stage IN LISTS stages)
        set(source "${CMAKE_CURRENT_SOURCE_DIR}/render/shaders/${source_name}.${stage}")
        set(binary "${ra2_shader_stage}/${shader}.${stage}.spv")
        set(header "${ra2_shader_stage}/${shader}.${stage}.hpp")
        set(define_args)
        if(shader_define)
            list(APPEND define_args "-D${shader_define}=1")
        endif()
        add_custom_command(OUTPUT "${binary}" "${header}"
            COMMAND "${ra2_shader_compiler}" -V --target-env vulkan1.0 -S "${stage}"
                ${define_args} -o "${binary}" "${source}"
            COMMAND "${CMAKE_COMMAND}" "-DINPUT=${binary}" "-DOUTPUT=${header}"
                "-DNAME=${shader}_${stage}" -P "${CMAKE_CURRENT_LIST_DIR}/EmbedSpirv.cmake"
            DEPENDS "${source}" "${CMAKE_CURRENT_LIST_DIR}/EmbedSpirv.cmake" ${ra2_shader_compiler_dependencies}
            VERBATIM)
        list(APPEND ra2_spirv_headers "${header}")
        string(APPEND ra2_shader_header "#include \"${shader}.${stage}.hpp\"\n")
    endforeach()
    if(stages STREQUAL "comp")
        string(APPEND program "{${shader}_comp, sizeof(${shader}_comp)/4}, {}, {}")
    else()
        string(APPEND program "{}, {${shader}_vert, sizeof(${shader}_vert)/4}, {${shader}_frag, sizeof(${shader}_frag)/4}")
    endif()
    string(APPEND ra2_shader_programs "${program}};\n")
endforeach()
string(APPEND ra2_shader_header "namespace render {\n${ra2_shader_programs}}\n")
file(CONFIGURE OUTPUT "${ra2_shader_stage}/map_shader_resources.hpp" CONTENT "${ra2_shader_header}" @ONLY)
add_custom_target(ra2_render_shaders DEPENDS ${ra2_spirv_headers})
