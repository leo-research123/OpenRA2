target_compile_definitions(ra2_core PRIVATE RA2_PROJECT_VERSION="${PROJECT_VERSION}")
set(RA2_CONTROL_CAPACITY 16384 CACHE STRING "Standalone screen selection and command capacity (power of two, at least 128)")
target_compile_definitions(ra2_core PUBLIC RA2_CONTROL_CAPACITY=${RA2_CONTROL_CAPACITY})
# Identify diagnostic sessions without exposing repository paths in the ABI.
execute_process(COMMAND git describe --always --dirty --abbrev=12
    WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
    OUTPUT_VARIABLE ra2_diagnostics_build OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT ra2_diagnostics_build)
    set(ra2_diagnostics_build "unknown")
endif()
set_property(SOURCE core/src/runtime_diagnostics.cpp APPEND PROPERTY COMPILE_DEFINITIONS
    RA2_DIAGNOSTICS_BUILD="${ra2_diagnostics_build}")
# Keep numerical policy private to the standalone implementation.
if(MSVC)
    target_compile_options(ra2_core PRIVATE /fp:strict)
else()
    target_compile_options(ra2_core PRIVATE -fno-fast-math -ffp-contract=off)
endif()
# Preserve original destructor stores, including inline YRpp destructors in consumers.
if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    include(CheckCXXCompilerFlag)
    if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
        set(_ra2_no_lifetime_dse "/clang:-fno-lifetime-dse")
    else()
        set(_ra2_no_lifetime_dse "-fno-lifetime-dse")
    endif()
    check_cxx_compiler_flag("${_ra2_no_lifetime_dse}" RA2_CXX_HAS_NO_LIFETIME_DSE)
    if(RA2_CXX_HAS_NO_LIFETIME_DSE)
        target_compile_options(ra2_core PUBLIC "${_ra2_no_lifetime_dse}")
    endif()
    unset(_ra2_no_lifetime_dse)
endif()
target_include_directories(ra2_core PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/core/include")
ra2_core_private_includes(ra2_core)
set_target_properties(ra2_core PROPERTIES POSITION_INDEPENDENT_CODE ON)
include("${CMAKE_CURRENT_LIST_DIR}/DebugCommands.cmake")
