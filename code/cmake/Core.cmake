ra2_core_private_includes(ra2_debug_command_objects)
target_compile_definitions(ra2_debug_command_objects PRIVATE "$<TARGET_PROPERTY:ra2_core,COMPILE_DEFINITIONS>")
target_compile_options(ra2_debug_command_objects PRIVATE "$<TARGET_PROPERTY:ra2_core,COMPILE_OPTIONS>")
# Propagate raw command objects to final links. A static archive alone could
# discard self-registering translation units with no referenced entry symbol.
target_link_libraries(ra2_core INTERFACE "$<TARGET_OBJECTS:ra2_debug_command_objects>")
if(WIN32)
    target_link_libraries(ra2_core PRIVATE winmm)
endif()
