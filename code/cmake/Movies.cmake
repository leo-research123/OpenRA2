# Optional core decoder. libav types remain private to the implementation.
find_package(PkgConfig REQUIRED)
pkg_check_modules(RA2_LIBAV REQUIRED IMPORTED_TARGET
    libavformat>=61 libavcodec>=61 libavutil>=59 libswscale>=8 libswresample>=5)
foreach(component IN ITEMS avformat avcodec avutil swscale swresample)
    if(component STREQUAL "avformat" OR component STREQUAL "avcodec")
        set(next_major 62)
    elseif(component STREQUAL "avutil")
        set(next_major 60)
    elseif(component STREQUAL "swscale")
        set(next_major 9)
    else()
        set(next_major 6)
    endif()
    if(NOT RA2_LIBAV_lib${component}_VERSION VERSION_LESS "${next_major}")
        message(FATAL_ERROR "The movie device requires the FFmpeg 7 ABI family")
    endif()
endforeach()
target_sources(ra2_core PRIVATE core/src/movie_decoder_ffmpeg.cpp)
target_link_libraries(ra2_core PRIVATE PkgConfig::RA2_LIBAV)
# Retain the existing host target name while the decoder belongs to the core.
add_library(ra2_movies INTERFACE)
add_library(ra2::movies ALIAS ra2_movies)
target_link_libraries(ra2_movies INTERFACE ra2_core)
