#version 450

// Dispatches preserve packet order. A laser batch contains only packets with
// disjoint color read/write footprints, one packet per invocation. A pixel batch
// gives each invocation one destination pixel and applies every member packet
// covering it in submission order. Other packets own one destination pixel per
// invocation; warp packets run serially.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Bindings and the 20-word packet layout are shared with the bridge.
// See README.md for field meanings, source formats and per-kind state access.
layout(set = 0, binding = 0, std430) readonly buffer Parameters {
    int packet_words[];
};
// Source and palette words of every packet live in the same immutable arena.
// Their per-packet word offsets come from the schedule buffer below.
layout(set = 0, binding = 1, std430) readonly buffer Source {
    uint source_texels[];
};
// The frame color, shared with the raster path (map_raster.vert/.frag). Color is
// RGBA8 holding expanded RGB565; raster blends produce arbitrary 8-bit values,
// which reads truncate back to RGB565.
layout(set = 0, binding = 2, rgba8) uniform image2D output_image;
// Scene Z: the raster path's D32F attachment. FrameDepth selects world or legacy Z. Compute paths
// only test against it; every packet that writes Z is rasterized.
layout(set = 0, binding = 3) uniform sampler2D depth_texture;
// Read-only in this consumer, not constant: map_abuffer.comp implements the
// original dynamic producers. Native frame scheduling still needs to connect it.
layout(set = 0, binding = 4, std430) readonly buffer Lighting {
    uint light_intensities[];
};

// 256 unlit RGBA8 colors, followed by shade_count tables of 256 colors.
// The host prepares these tables using the original palette conversion.
layout(set = 0, binding = 5, std430) readonly buffer Palette {
    uint palette_colors[];
};
// Words 2 * packet and 2 * packet + 1 hold the source and palette word offsets.
// Pixel batch spatial bins follow at offsets named by their header packets.
layout(set = 0, binding = 6, std430) readonly buffer Schedule {
    int schedule_words[];
};
layout(set = 0, binding = 7, std430) readonly buffer FrameDepth {
    int world_depth;
    int camera_y;
    int unused0;
    int unused1;
};
layout(push_constant, std430) uniform Batch {
    int packet_index;
} batch;

#ifdef RESIDENT_RESOURCES
layout(set = 0, binding = 8) uniform usampler2DArray resource_pages;
// Four words per source: a slot (first word, width, height, count) or a shape sequence
// frame table entry (colour plane byte address, width, height, prefix plane byte
// address). Slots and entries share the buffer; see game::MapSequenceTable.
layout(set = 0, binding = 9, std430) readonly buffer ResourceMetadata {
    int resource_words[];
};
uint source_word(int index) {
    return texelFetch(resource_pages, ivec3(index & 1023, (index >> 10) & 1023, index >> 20), 0).r;
}
uint palette_word(int index) { return source_word(index); }
uint source_byte(int index) { return (source_word(index >> 2) >> uint((index & 3) * 8)) & 0xFFu; }
#else
uint source_word(int index) { return source_texels[index]; }
uint palette_word(int index) { return palette_colors[index]; }
#endif

// These aliases name the wire layout without eagerly loading a whole packet.
// Words 10/11/12/15 have different meanings for different drawing paths.
const int PACKET_WORD_COUNT = 20;
// Private to each shader invocation, including the selected batch member.
int current_packet;
// Word offset of current_packet, resolved once whenever the packet changes.
int packet_offset;
// Mixed raster/compute frames share one compact record buffer. Reference
// fixtures and compute-only frames retain the original fixed stride.
int packet_base(int index) {
    return packet_words[0] == -0x524132 ? packet_words[2 + index] : index * PACKET_WORD_COUNT;
}
void select_packet(int index) {
    current_packet = index;
    packet_offset = packet_base(index);
}
#define PACKET_WORD(slot) packet_words[packet_offset + (slot)]
#define TARGET_WIDTH PACKET_WORD(0)
#define TARGET_HEIGHT PACKET_WORD(1)
#define SOURCE_WIDTH PACKET_WORD(2)
#define SOURCE_HEIGHT PACKET_WORD(3)
#define DESTINATION_X PACKET_WORD(4)
#define DESTINATION_Y PACKET_WORD(5)
#define CLIP_X PACKET_WORD(6)
#define CLIP_Y PACKET_WORD(7)
#define CLIP_WIDTH PACKET_WORD(8)
#define CLIP_HEIGHT PACKET_WORD(9)
#define PALETTE_LIGHTING_ENABLED (PACKET_WORD(10) & 1)
#define SHAPE_TINT_RGB565 (uint(PACKET_WORD(10)) >> 16u)
#define LIGHT_STRENGTH_FROM_SOURCE PACKET_WORD(10)
#define PALETTE_INTENSITY PACKET_WORD(11)
#define EFFECT_RGB PACKET_WORD(11)
#define LIGHT_FLAGS PACKET_WORD(11)
#define SHADE_COUNT PACKET_WORD(12)
#define EFFECT_OPACITY PACKET_WORD(12)
#define LIGHT_STRENGTH PACKET_WORD(12)
#define PACKED_DRAW_MODE PACKET_WORD(13)
#define BASE_DEPTH PACKET_WORD(14)
#define PACKED_DEPTH_GRADIENT PACKET_WORD(15)
#define WRAP_RESOURCE_DEPTH PACKET_WORD(15)
#define STATE_ORIGIN_Y PACKET_WORD(16)
#define REPEAT_FIRST_LIGHT_ROW PACKET_WORD(17)
#define FIRST_VISIBLE_Y PACKET_WORD(18)
#define DRAW_KIND PACKET_WORD(19)
#define SOURCE_BASE schedule_words[current_packet * 2]
#define PALETTE_BASE schedule_words[current_packet * 2 + 1]

const int DRAW_SHAPE_OR_TILE = 0;
const int DRAW_COPY = 1;
const int DRAW_FILL = 2;
const int DRAW_INDEXED = 3;
const int DRAW_SELECTION_LINE = 4;
const int DRAW_SPOTLIGHT = 5;
const int DRAW_DEPTH_GLOW = 6;
const int DRAW_DEPTH_ALPHA = 7;
const int DRAW_PARTICLE = 8;
const int DRAW_LASER_ADDITIVE = 9;
const int DRAW_LASER_PAIR = 10;
const int DRAW_LASER_BATCH = 11;
const int DRAW_WAVE = 12;
const int DRAW_PIXEL_BATCH = 13;
const int DRAW_LIGHT_TEST = 14;
// Must match game::PixelBinSize; a multiple of the 8 by 8 workgroup.
const int PIXEL_BIN_SIZE = 32;

// Packet depth modes (0 none, 1 read/write, 2 read) differ from the public
// ShapeDepthMode enum values.
const int DEPTH_NONE = 0;
const int ORIGINAL_SHAPE_DEPTH_FLAG = 0x10000;
const int AUXILIARY_DEPTH_FLAG = 0x20000;
const int PLAIN_WARP_FLAG = 0x40000;
// The kind 0 source is a shape sequence frame (8-bit planes); SOURCE_BASE is then
// its frame table entry index. Auxiliary depth names the SHA frame's entry in
// word 15 and its offset (x | y << 16) in word 18. Matches render::ShapePlanesFlag.
const int SHAPE_PLANES_FLAG = 0x80000;

// The percentage describes transparency, not source opacity.
const int BLEND_SHADOW = 1;
const int BLEND_TRANSPARENT_25 = 2;
const int BLEND_TRANSPARENT_50 = 3;
const int BLEND_TRANSPARENT_75 = 4;

const uint SHAPE_TEXEL_OCCUPIED = 0x10000u;
const uint INDEXED_TEXEL_OCCUPIED = 0x1000000u;
const uint WORD_MASK = 0xFFFFu;
const uint NEUTRAL_LIGHT = 127u;
const uint OPAQUE_ALPHA = 0xFF000000u;

// After a packed right shift, remove bits that crossed RGB565 channel borders.
const uint RGB565_HALF_MASK = 0x7BEFu;
const uint RGB565_QUARTER_MASK = 0x39E7u;
const int LIGHT_DARKEN_FLAG = 0x1;
const int LIGHT_SKIP_RED_FLAG = 0x2;  // Green/blue are this bit shifted by 1/2.

// Color helpers: RGBA8 words store red in the low byte; RGB565 stores red in
// bits 11..15. All blending retains the calibrated integer truncation order.
uint rgba8_to_rgb565(uint color) { return ((color & 0xF8u) << 8) | ((color >> 5) & 0x7E0u) | ((color >> 19) & 0x1Fu); }

uint rgb565_to_rgba8(uint color) {
    uint red = (color >> 11) & 0x1Fu;
    uint green = (color >> 5) & 0x3Fu;
    uint blue = color & 0x1Fu;

    // Output expansion rounds to nearest, matching the CPU and reference PNGs.
    // Effect arithmetic below instead scales channels by 8/4/8 before mixing.
    return ((red * 255u + 15u) / 31u) | (((green * 255u + 31u) / 63u) << 8) | (((blue * 255u + 15u) / 31u) << 16) |
           OPAQUE_ALPHA;
}

// Frame state access by pixel position. Colors enter and leave as RGB565
// words: the frame holds expanded RGB565, whose truncation is exact, so every
// path computes on the truncated word and the expansion happens once, in the
// store. Only arbitrary RGBA8 source words (copy, fill, palette entries) are
// truncated by their callers. Linear indices remain for the light buffer and
// for the paths whose original address arithmetic may leave the row.
ivec2 target_pixel(int index) { return ivec2(index % TARGET_WIDTH, index / TARGET_WIDTH); }

// Circular row of a destination row. Rows already in range (the usual case,
// and every row for a zero origin) skip the two modulo operations.
int wrapped_state_row(int y) {
    int row = y - STATE_ORIGIN_Y;
    if (uint(row) >= uint(TARGET_HEIGHT)) {
        row = (row % TARGET_HEIGHT + TARGET_HEIGHT) % TARGET_HEIGHT;
    }
    return row;
}

// A pixel batch invocation applies every member to one color pixel. It keeps
// the color in a register and writes it back once: Metal does not order an
// image read after an image write in the same thread without a texture fence,
// which the GLSL here cannot request. Other paths read each pixel before
// writing it, or (plain warp) read pixels not yet written.
bool state_cached = false;
ivec2 cached_color_position = ivec2(-1);
uint cached_color = 0u;
bool cached_color_written = false;

uint image_color(ivec2 position) {
    uvec3 byte = uvec3(round(imageLoad(output_image, position).rgb * 255.0));
    return rgba8_to_rgb565(byte.r | (byte.g << 8) | (byte.b << 16));
}

void write_image_color(ivec2 position, uint color565) {
    uint expanded = rgb565_to_rgba8(color565);
    imageStore(output_image, position,
               vec4(expanded & 0xFFu, (expanded >> 8) & 0xFFu, (expanded >> 16) & 0xFFu, 255u) / 255.0);
}

uint load_color(ivec2 position) {
    if (!state_cached) {
        return image_color(position);
    }
    if (any(notEqual(position, cached_color_position))) {
        cached_color_position = position;
        cached_color = image_color(position);
    }
    return cached_color;
}

void store_color(ivec2 position, uint color565) {
    if (!state_cached) {
        write_image_color(position, color565);
        return;
    }
    cached_color_position = position;
    // Bits above the three channels never reach the image.
    cached_color = color565 & WORD_MASK;
    cached_color_written = true;
}

uint load_depth(ivec2 position) {
    float depth = texelFetch(depth_texture, position, 0).r;
    return world_depth != 0 ? uint(clamp(int(depth * 16777216.0) - 0x100000 + camera_y, 0, 65535))
                            : uint(depth * 65536.0);
}

uint blend_rgb565(uint foreground565, uint background565, int blend_mode) {
    uint blended565;

    if (blend_mode == BLEND_SHADOW) {
        blended565 = (background565 >> 1) & RGB565_HALF_MASK;
    } else if (blend_mode == BLEND_TRANSPARENT_50) {
        blended565 = ((foreground565 >> 1) & RGB565_HALF_MASK) + ((background565 >> 1) & RGB565_HALF_MASK);
    } else if (blend_mode == BLEND_TRANSPARENT_25) {
        blended565 = 3u * ((foreground565 >> 2) & RGB565_QUARTER_MASK) + ((background565 >> 2) & RGB565_QUARTER_MASK);
    } else {
        blended565 = ((foreground565 >> 2) & RGB565_QUARTER_MASK) + 3u * ((background565 >> 2) & RGB565_QUARTER_MASK);
    }
    return blended565;
}

uint depth_alpha_color(ivec2 output_position, int state_index) {
    uint background565 = load_color(output_position);
    uint light_intensity = light_intensities[state_index] & WORD_MASK;
    uint opacity = uint(EFFECT_OPACITY);
    uint packed_rgb = uint(EFFECT_RGB);
    uvec3 source_rgb = uvec3(packed_rgb & 0xFFu, (packed_rgb >> 8) & 0xFFu, (packed_rgb >> 16) & 0xFFu);
    uvec3 destination_rgb =
        uvec3(((background565 >> 11) & 0x1Fu) * 8u, ((background565 >> 5) & 0x3Fu) * 4u, (background565 & 0x1Fu) * 8u);

    // Floor the weighted terms separately, then apply ABuffer, including 127.
    uvec3 source_part = (opacity * source_rgb) >> 8u;
    uvec3 destination_part = ((256u - opacity) * destination_rgb) >> 8u;
    uvec3 lit_rgb = (light_intensity * (source_part + destination_part)) >> 7u;
    return (((lit_rgb.r >> 3u) << 11u) | ((lit_rgb.g >> 2u) << 5u) | (lit_rgb.b >> 3u)) & WORD_MASK;
}

uint light_effect_color(int strength, ivec2 output_position) {
    uint background565 = load_color(output_position);
    ivec3 rgb = ivec3(int((background565 >> 11) & 0x1Fu) * 8, int((background565 >> 5) & 0x3Fu) * 4,
                      int(background565 & 0x1Fu) * 8);
    for (int channel = 0; channel < 3; ++channel) {
        if ((LIGHT_FLAGS & LIGHT_DARKEN_FLAG) != 0) {
            rgb[channel] = ((256 - strength) * rgb[channel]) >> 8;
        } else if ((LIGHT_FLAGS & (LIGHT_SKIP_RED_FLAG << channel)) == 0) {
            // Preserve unsigned multiplication followed by signed shift.
            rgb[channel] = min(255, rgb[channel] + (int(uint(strength) * uint(rgb[channel])) >> 8));
        }
    }
    return uint(((rgb.r >> 3) << 11) | ((rgb.g >> 2) << 5) | (rgb.b >> 3));
}

uint particle_color(uint light_intensity) {
    // ParticleClass 0x0062CEC0: the core supplies interpolated RGB. Apply
    // ABuffer only below 127, then quantize without changing scene Z.
    uint packed_rgb = uint(EFFECT_RGB);
    uvec3 rgb = uvec3(packed_rgb & 0xFFu, (packed_rgb >> 8) & 0xFFu, (packed_rgb >> 16) & 0xFFu);
    if (light_intensity < NEUTRAL_LIGHT) {
        rgb = (rgb * light_intensity) >> 7;
    }
    return ((rgb.r >> 3) << 11) | ((rgb.g >> 2) << 5) | (rgb.b >> 3);
}

uint selection_line_color(uint source_sample, int state_index) {
    uint color565 = rgba8_to_rgb565(source_sample);
    uint light_intensity = light_intensities[state_index] & WORD_MASK;
    if (light_intensity != NEUTRAL_LIGHT) {
        // Expand, light and truncate each channel before packing it again.
        // Retain the final WORD mask: this path does not clamp the channels.
        uint red = (((((color565 >> 11) & 0x1Fu) * 8u * light_intensity) >> 7) >> 3) << 11;
        uint green = (((((color565 >> 5) & 0x3Fu) * 4u * light_intensity) >> 7) >> 2) << 5;
        uint red_green = red | green;
        uint blue = (((color565 & 0x1Fu) * 8u * light_intensity) >> 7) >> 3;
        color565 = red_green | blue;
    }
    return color565 & WORD_MASK;
}

// Row limits are 1 or 3 and rows below the first visible one are clipped, so
// the numerator is non-negative and the divisor a constant in practice. Any
// other input takes the general signed division, as before.
int gradient_steps(int numerator, int limit) {
    if (numerator >= 0) {
        if (limit == 3) {
            return int(uint(numerator) / 3u);
        }
        if (limit == 1) {
            return numerator;
        }
    }
    return numerator / limit;
}

int palette_pixel_depth(ivec2 source_position, ivec2 destination_position, uint source_sample,
                        bool original_shape_depth) {
    int pixel_depth;
    if (original_shape_depth) {
        int phase = PACKED_DEPTH_GRADIENT & 0xFF;
        int step = (PACKED_DEPTH_GRADIENT >> 8) & 0xFF;
        int limit = (PACKED_DEPTH_GRADIENT >> 16) & 0xFF;
        if ((PACKED_DRAW_MODE & AUXILIARY_DEPTH_FLAG) != 0) {
            // RLE prefix overhang is stored at the first visible source
            // column. It relocates the auxiliary signed 8-bit Z sample.
            int left = max(CLIP_X - DESTINATION_X, 0);
#ifdef RESIDENT_RESOURCES
            if ((PACKED_DRAW_MODE & SHAPE_PLANES_FLAG) != 0) {
                int pitch = resource_words[SOURCE_BASE * 4 + 1];
                int prefix_base = resource_words[SOURCE_BASE * 4 + 3];
                int prefix = prefix_base < 0 ? 0 : int(source_byte(prefix_base + source_position.y * pitch + left));
                int auxiliary_entry = PACKED_DEPTH_GRADIENT;
                int auxiliary_pitch = resource_words[auxiliary_entry * 4 + 1];
                int ax = source_position.x - prefix + (FIRST_VISIBLE_Y & 0xFFFF);
                int ay = source_position.y + (FIRST_VISIBLE_Y >> 16);
                uint delta = source_byte(resource_words[auxiliary_entry * 4] + ay * auxiliary_pitch + ax);
                return BASE_DEPTH - (int(delta << 24) >> 24);
            }
#endif
            int prefix = int((source_word(SOURCE_BASE + source_position.y * SOURCE_WIDTH + left) >> 17) & 0xFFu);
            uint auxiliary = source_word(SOURCE_BASE + source_position.y * SOURCE_WIDTH + source_position.x - prefix);
            pixel_depth = BASE_DEPTH - (int(auxiliary << 16) >> 24);
        } else {
            // The top byte is a signed delta; division must precede it.
            pixel_depth =
                BASE_DEPTH + gradient_steps(phase + (destination_position.y - FIRST_VISIBLE_Y) * step, limit) *
                                 (PACKED_DEPTH_GRADIENT >> 24);
        }
    } else {
        // Indexed samples carry signed 16-bit Z; SHP/TMP carry unsigned
        // 8-bit resource Z. Keep the casts before arithmetic right shifts.
        pixel_depth = BASE_DEPTH +
                      (DRAW_KIND == DRAW_INDEXED ? (int(source_sample << 8) >> 16) : int((source_sample >> 8) & 0xFFu));
        if (WRAP_RESOURCE_DEPTH != 0) {
            pixel_depth = int(uint(pixel_depth) & WORD_MASK);
        }
    }
    return pixel_depth;
}

uint shaded_palette_index(uint source_sample, ivec2 destination_position, int state_index) {
    uint palette_index = source_sample & 0xFFu;
    if (PALETTE_LIGHTING_ENABLED != 0) {
        if (REPEAT_FIRST_LIGHT_ROW != 0) {
            state_index = wrapped_state_row(FIRST_VISIBLE_Y) * TARGET_WIDTH + destination_position.x;
        }
        // AlphaLightingRemapClass 0x00420140: WORD lighting is a byte-range
        // intensity, not opacity. The divisor is the original 254 * 127.
        // Host bounds (1..256 shades, 0..254 intensity) prevent overflow.
        uint maximum_shade = uint(SHADE_COUNT - 1);
        uint shade = min(maximum_shade,
                         maximum_shade * uint(PALETTE_INTENSITY) * min(light_intensities[state_index], 255u) / 32258u);
        palette_index += 256u + shade * 256u;
    }
    return palette_index;
}

// Keep rejection and buffer writes in the entry point. Calculation helpers have
// a single return, preserving the original control flow when they are inlined.
void draw_pixel(ivec2 source_position) {
    // Negative positions occur only for pixel batch members outside this packet.
    if (source_position.x < 0 || source_position.y < 0 || source_position.x >= SOURCE_WIDTH ||
        source_position.y >= SOURCE_HEIGHT) {
        return;
    }

    uint source_sample;
#ifdef RESIDENT_RESOURCES
    if (DRAW_KIND == DRAW_SHAPE_OR_TILE && (PACKED_DRAW_MODE & SHAPE_PLANES_FLAG) != 0) {
        // 8-bit colour plane: the palette index; zero is transparent.
        uint index = source_byte(resource_words[SOURCE_BASE * 4] +
                                 source_position.y * resource_words[SOURCE_BASE * 4 + 1] + source_position.x);
        source_sample = index != 0u ? (index | SHAPE_TEXEL_OCCUPIED) : 0u;
    } else
#endif
    {
        source_sample = source_word(
            SOURCE_BASE + (DRAW_KIND == DRAW_FILL ? 0 : source_position.y * SOURCE_WIDTH + source_position.x));
    }
    if (DRAW_KIND == DRAW_SHAPE_OR_TILE && (source_sample & SHAPE_TEXEL_OCCUPIED) == 0u) {
        return;
    }
    if (DRAW_KIND == DRAW_INDEXED &&
        ((source_sample & INDEXED_TEXEL_OCCUPIED) == 0u || (source_sample & 0xFFu) == 0u)) {
        return;
    }

    ivec2 destination_position = source_position + ivec2(DESTINATION_X, DESTINATION_Y);
    if (destination_position.x < CLIP_X || destination_position.y < CLIP_Y ||
        destination_position.x >= CLIP_X + CLIP_WIDTH || destination_position.y >= CLIP_Y + CLIP_HEIGHT ||
        destination_position.x < 0 || destination_position.y < 0 || destination_position.x >= TARGET_WIDTH ||
        destination_position.y >= TARGET_HEIGHT) {
        return;
    }
    if (DRAW_KIND == DRAW_COPY || DRAW_KIND == DRAW_FILL) {
        store_color(destination_position, rgba8_to_rgb565(source_sample));
        return;
    }

    // Color uses screen coordinates. Z/ABuffer instead use a circular row
    // origin; negative row offsets wrap correctly.
    int state_row = wrapped_state_row(destination_position.y);
    ivec2 state_position = ivec2(destination_position.x, state_row);
    int state_index = state_row * TARGET_WIDTH + destination_position.x;
    if (DRAW_KIND == DRAW_LIGHT_TEST) {
        if ((light_intensities[state_index] == 0u) == (PACKET_WORD(10) != 0)) {
            store_color(destination_position, rgba8_to_rgb565(source_sample));
        }
        return;
    }
    if (DRAW_KIND == DRAW_LASER_ADDITIVE) {
        if (BASE_DEPTH >= int(load_depth(state_position))) return;
        uint bg = load_color(destination_position);
        ivec3 color = ivec3(int((bg >> 11u) & 31u) * 8, int((bg >> 5u) & 63u) * 4, int(bg & 31u) * 8);
        int light_x = PACKET_WORD(15) < 0 ? destination_position.x : PACKET_WORD(15);
        int light = int(light_intensities[state_row * TARGET_WIDTH + light_x] & WORD_MASK);
        color += ivec3(EFFECT_RGB * light, EFFECT_OPACITY * light, PACKET_WORD(10) * light) >> 7;
        int overflow = 0, count = 0;
        for (int i = 0; i < 3; ++i)
            if (color[i] >= 255) {
                overflow += color[i] - 255;
                ++count;
            }
        if (count == 1) overflow >>= 1;
        if (count == 1 || count == 2)
            for (int i = 0; i < 3; ++i)
                if (color[i] < 255) color[i] += overflow;
        color = min(color, ivec3(255));
        uint packed = (uint(color.x >> 3) << 11u) | (uint(color.y >> 2) << 5u) | uint(color.z >> 3);
        store_color(destination_position, packed);
        return;
    }
    if (DRAW_KIND == DRAW_DEPTH_ALPHA) {
        // DSurface 0x004BEAC0: equal depth is hidden; scene Z is read-only.
        if (EFFECT_OPACITY < 8 || BASE_DEPTH >= int(load_depth(state_position)) ||
            light_intensities[state_index] == 0u) {
            return;
        }
        store_color(destination_position, depth_alpha_color(destination_position, state_index));
        return;
    }
    if (DRAW_KIND == DRAW_SPOTLIGHT || DRAW_KIND == DRAW_DEPTH_GLOW) {
        // Spotlight ignores Z; depth glow rejects equal or farther depth.
        // Neither path reads ABuffer or writes scene Z.
        if (DRAW_KIND == DRAW_DEPTH_GLOW && BASE_DEPTH >= int(load_depth(state_position))) {
            return;
        }
        int strength = LIGHT_STRENGTH_FROM_SOURCE != 0 ? int(source_sample & 0xFFu) : LIGHT_STRENGTH;
        if (strength == 0) {
            return;
        }
        store_color(destination_position, light_effect_color(strength, destination_position));
        return;
    }

    int depth_mode = PACKED_DRAW_MODE & 0xFF;
    int blend_mode = (PACKED_DRAW_MODE >> 8) & 0xFF;
    bool original_shape_depth = (PACKED_DRAW_MODE & ORIGINAL_SHAPE_DEPTH_FLAG) != 0;
    if (DRAW_KIND == DRAW_PARTICLE) {
        uint light_intensity = light_intensities[state_index] & WORD_MASK;
        if (BASE_DEPTH >= int(load_depth(state_position)) || light_intensity == 0u) {
            return;
        }
        store_color(destination_position, particle_color(light_intensity));
        return;
    }
    if (DRAW_KIND == DRAW_SELECTION_LINE) {
        // DSurface 0x004BFD30: equal depth is hidden; scene Z is read-only.
        if (BASE_DEPTH >= int(load_depth(state_position)) || light_intensities[state_index] == 0u) {
            return;
        }
        store_color(destination_position, selection_line_color(source_sample, state_index));
        return;
    }

    // SHP/TMP and indexed images share depth testing and palette lookup.
    if (depth_mode != DEPTH_NONE) {
        int pixel_depth =
            palette_pixel_depth(source_position, destination_position, source_sample, original_shape_depth);
        // Original SHP hides equal depth; the other resource path accepts it.
        if (original_shape_depth ? pixel_depth >= int(load_depth(state_position))
                                 : pixel_depth > int(load_depth(state_position))) {
            return;
        }
        // Z writers are rasterized; here depth_mode is a read (plain warp).
    }
    // Shadows darken the destination and never look up a palette color.
    if (blend_mode == BLEND_SHADOW) {
        store_color(destination_position, blend_rgb565(0u, load_color(destination_position), blend_mode));
        return;
    }
    uint palette_index = shaded_palette_index(source_sample, destination_position, state_index);
    uint color = rgba8_to_rgb565(palette_word(PALETTE_BASE + int(palette_index)));
    // Include DRAW_INDEXED: original uncached VXL bitmaps reach PlainBlit via
    // 0x00706ED0 -> 0x004AF2A0 -> 0x004373B0. BlitTransXlatAlphaZRead<WORD>::
    // Blit_Copy_Tinted (0x00494C40) ORs the palette color with tint at 0x00494CD9.
    // type_drawing_packets.cpp::original_shape_mode packs tint only for the
    // original tint-capable blitter modes; shadows and translucency omit it.
    if (SHAPE_TINT_RGB565 != 0u) {
        color |= SHAPE_TINT_RGB565;
    }
    if (blend_mode >= BLEND_TRANSPARENT_25 && blend_mode <= BLEND_TRANSPARENT_75) {
        ivec2 background_position = destination_position;
        if ((PACKED_DRAW_MODE & PLAIN_WARP_FLAG) != 0) {
            // PlainBlit 0x4373B0 seeds from the clipped first pixel, then
            // toggles with XOR 3 for each row; 0x495590 reads dest[offset].
            int left = max(max(DESTINATION_X, CLIP_X), 0);
            int top = max(max(DESTINATION_Y, CLIP_Y), 0);
            int row = top - STATE_ORIGIN_Y;
            int offset = (2 * (row & 1)) | ((left ^ row) & 1);
            if (((destination_position.y - top) & 1) != 0) offset ^= 3;
            // The offset may cross the end of the row: keep the original
            // linear address and convert it back to a position.
            int background_index = destination_position.y * TARGET_WIDTH + destination_position.x + offset;
            // The original raw pointer may overread a tightly packed target
            // edge. Keep GPU reads inside the allocated destination surface.
            if (background_index >= TARGET_WIDTH * TARGET_HEIGHT) return;
            background_position = target_pixel(background_index);
        }
        color = blend_rgb565(color, load_color(background_position), blend_mode);
    }
    store_color(destination_position, color);
}

int laser_weight(int index) {
    int v = index - 128;
    return (v * v * v + 2097152) / 16384;
}
uint laser_pair_color(uint bg, int index, uint light) {
    uint rgb = uint(EFFECT_RGB);
    uvec3 c = uvec3(((bg >> 11u) & 31u) * 8u, ((bg >> 5u) & 63u) * 4u, (bg & 31u) * 8u);
    uint fg = uint(laser_weight(index)), back = uint(laser_weight(256 - index));
    for (int i = 0; i < 3; ++i)
        if ((PACKET_WORD(10) & (1 << i)) != 0)
            c[i] = min(255u, (light * (((rgb >> uint(8 * i)) & 255u) * fg + c[i] * back)) >> 15u);
    return (c.x >> 3u) << 11u | (c.y >> 2u) << 5u | (c.z >> 3u);
}
void draw_laser_pair() {
    ivec2 p = ivec2(DESTINATION_X, DESTINATION_Y), q = p + ivec2(PACKET_WORD(17), PACKET_WORD(18));
    if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, ivec2(TARGET_WIDTH, TARGET_HEIGHT)))) return;
    // Only q is range checked, so p keeps its linear address (it may leave the row).
    ivec2 at = target_pixel(p.y * TARGET_WIDTH + p.x), next = q;
    int row = wrapped_state_row(p.y);
    int state = row * TARGET_WIDTH + (PACKET_WORD(15) < 0 ? p.x : PACKET_WORD(15));
    uint light = light_intensities[state] & WORD_MASK;
    if (BASE_DEPTH >= int(load_depth(target_pixel(state))) || light == 0u) return;
    uint a = load_color(at), b = load_color(next);
    if ((PACKED_DRAW_MODE & 1) != 0) {
        uint temp = a;
        a = b;
        b = temp;
    }
    store_color(at, laser_pair_color(a, EFFECT_OPACITY & 65535, light));
    store_color(next, laser_pair_color(b, int(uint(EFFECT_OPACITY) >> 16u), light));
}
// Wave refraction is deliberately serial: samples refer to the live color
// surface, including writes already made by this same original scan traversal.
void draw_wave() {
    for (int i = 0; i < PACKET_WORD(10); ++i) {
        int base = SOURCE_BASE + i * 5;
        ivec2 p = ivec2(source_word(base), source_word(base + 1));
        ivec2 q = ivec2(source_word(base + 2), source_word(base + 3));
        if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, ivec2(TARGET_WIDTH, TARGET_HEIGHT))) ||
            any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, ivec2(TARGET_WIDTH, TARGET_HEIGHT))))
            continue;
        if ((uint(BASE_DEPTH - p.y) & WORD_MASK) >= load_depth(p)) continue;
        uint color = load_color(q);
        ivec3 rgb = ivec3(int((color >> 11u) & 31u) * 8, int((color >> 5u) & 63u) * 4, int(color & 31u) * 8);
        int strength = int(source_word(base + 4));
        if (EFFECT_RGB == 0) {
            rgb.y += (strength * rgb.y) >> 8;
            rgb.z += (strength * rgb.z) >> 8;
        } else if (EFFECT_RGB == 3) {
            rgb.x += ((strength / 2) * rgb.x) >> 8;
            rgb.z += (strength * rgb.z) >> 6;
        } else {
            rgb.x += strength >> 2;
            rgb.z += (3 * strength) >> 3;
        }
        rgb = min(rgb, ivec3(255));
        store_color(p, uint((rgb.x >> 3) << 11 | (rgb.y >> 2) << 5 | (rgb.z >> 3)));
        memoryBarrierImage();
    }
}
// Kind 13 header words. A zero mask flag (the default) draws every pixel.
#define BATCH_BIN_COLUMNS PACKET_WORD(2)
#define BATCH_BIN_ROWS PACKET_WORD(3)
#define BATCH_BIN_TABLE PACKET_WORD(4)
#define BATCH_FIRST_BIN_X PACKET_WORD(5)
#define BATCH_FIRST_BIN_Y PACKET_WORD(6)

// Every member reads and writes only the pixel and circular Z/ABuffer entry of
// this invocation, with one shared row origin, so applying the bin's ordered
// member list here equals one dispatch and barrier per member packet.
void draw_pixel_batch() {
    ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    ivec2 bin = local / PIXEL_BIN_SIZE;
    if (bin.x >= BATCH_BIN_COLUMNS || bin.y >= BATCH_BIN_ROWS) {
        return;
    }
    ivec2 pixel = ivec2(BATCH_FIRST_BIN_X, BATCH_FIRST_BIN_Y) * PIXEL_BIN_SIZE + local;
    if (pixel.x >= TARGET_WIDTH || pixel.y >= TARGET_HEIGHT) {
        return;
    }
    int entry = BATCH_BIN_TABLE + (bin.y * BATCH_BIN_COLUMNS + bin.x) * 2;
    int first = schedule_words[entry];
    int count = schedule_words[entry + 1];
    state_cached = true;
    for (int n = 0; n < count; ++n) {
        select_packet(schedule_words[first + n]);
        draw_pixel(pixel - ivec2(DESTINATION_X, DESTINATION_Y));
    }
    // Members share the target size, so the cached position is this pixel.
    if (cached_color_written) {
        write_image_color(cached_color_position, cached_color);
    }
}

// Kind 11: one batch member per invocation; members have disjoint footprints.
void draw_laser_batch() {
    int member = int(gl_WorkGroupID.x) * 64 + int(gl_LocalInvocationIndex);
    // Header words: 2 member count, 4 first member packet.
    if (member >= SOURCE_WIDTH) {
        return;
    }
    select_packet(DESTINATION_X + member);
    if (DRAW_KIND == DRAW_LASER_PAIR) {
        draw_laser_pair();
    } else {
        draw_pixel(ivec2(0));
    }
}

// PlainBlit warp reads destination pixels written earlier by the same packet,
// so one invocation walks the clipped rectangle in forward row/pixel order.
void draw_plain_warp_serially() {
    ivec2 destination = ivec2(DESTINATION_X, DESTINATION_Y);
    ivec2 first = max(ivec2(0), ivec2(CLIP_X, CLIP_Y) - destination);
    first = max(first, -destination);
    ivec2 last =
        min(ivec2(SOURCE_WIDTH, SOURCE_HEIGHT), ivec2(CLIP_X + CLIP_WIDTH, CLIP_Y + CLIP_HEIGHT) - destination);
    last = min(last, ivec2(TARGET_WIDTH, TARGET_HEIGHT) - destination);
    for (int y = first.y; y < last.y; ++y) {
        for (int x = first.x; x < last.x; ++x) {
            draw_pixel(ivec2(x, y));
        }
    }
}

void main() {
    select_packet(batch.packet_index);
    bool first_invocation = all(equal(gl_GlobalInvocationID, uvec3(0)));
    if (DRAW_KIND == DRAW_PIXEL_BATCH) {
        draw_pixel_batch();
    } else if (DRAW_KIND == DRAW_WAVE) {
        if (first_invocation) {
            draw_wave();
        }
    } else if (DRAW_KIND == DRAW_LASER_BATCH) {
        draw_laser_batch();
    } else if (DRAW_KIND == DRAW_LASER_PAIR) {
        if (first_invocation) {
            draw_laser_pair();
        }
    } else if ((PACKED_DRAW_MODE & PLAIN_WARP_FLAG) != 0) {
        if (first_invocation) {
            draw_plain_warp_serially();
        }
    } else {
        draw_pixel(ivec2(gl_GlobalInvocationID.xy));
    }
}
